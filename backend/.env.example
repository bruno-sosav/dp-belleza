# Puerto donde escucha la API
PORT=3000

# Conexión a MySQL. La base se crea una sola vez:
#   mysql -u root -p < database/setup.sql
# El backend se conecta como dp_app, que solo puede leer y escribir datos.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=dp_app
DB_PASSWORD=dp_app_local
DB_NAME=dp_belleza

# Secreto para firmar los tokens del panel de administración.
# Usar un valor largo y aleatorio, por ejemplo: openssl rand -hex 32
JWT_SECRET=cambiar-por-un-secreto-largo

# Orígenes que pueden llamar a la API, separados por coma:
# la web pública (frontend/cliente) y el panel (frontend/admin)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Clave para cifrar credenciales guardadas en la base (Mercado Pago).
# Opcional en desarrollo: si falta, se deriva de JWT_SECRET. En producción
# conviene una propia: openssl rand -hex 32
# CREDENCIALES_KEY=

# Dirección de la web pública: a dónde vuelve la clienta después de pagar la seña.
SITE_URL=http://localhost:5173

# Dirección pública de esta API (solo en producción). Con ella, Mercado Pago
# avisa los pagos al webhook. En local no hace falta: el pago se confirma
# cuando la clienta vuelve a la web.
# API_PUBLIC_URL=https://api.dpbelleza.com.ar
