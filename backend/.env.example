# Copiar como .env.local y completar. .env.local no se sube a git.
#
# La base se crea una sola vez:  mysql -u root -p < database/setup.sql

PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=dp_app
DB_PASSWORD=dp_app_local
DB_NAME=dp_belleza

# Origenes que pueden llamar a la API (separados por coma).
# En desarrollo: el Vite del cliente y el del panel.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
