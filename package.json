{
  "name": "dp-belleza",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "frontend/shared",
    "frontend/cliente",
    "frontend/admin",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev -w @dp/cliente",
    "dev:admin": "npm run dev -w @dp/admin",
    "build": "npm run build -w @dp/cliente && npm run build -w @dp/admin",
    "lint": "oxlint",
    "admin:hash": "node -e \"console.log(require('node:crypto').createHash('sha256').update(process.argv[1] ?? '').digest('hex'))\"",
    "dev:api": "npm run dev -w @dp/backend",
    "test": "npm run test -w @dp/backend"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
