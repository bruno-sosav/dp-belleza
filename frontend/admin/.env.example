# Copiar como .env.local y ajustar si hace falta.

# URL de la API. En desarrollo, el backend (npm run dev:api).
VITE_API_URL=http://localhost:3000

# URL de la web pública, para el link "Ver sitio" del panel.
# En desarrollo, el Vite de frontend/cliente (npm run dev).
VITE_SITE_URL=http://localhost:5173
